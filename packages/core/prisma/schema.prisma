generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id // Clerk user id
  email            String?
  credits          Int           @default(1) // free trial video
  reelCredits      Int           @default(0) // from reel packs (REEL_PACKS): they only make reels
  plan             Plan          @default(FREE)
  billingCustomerId     String?  @unique // Dodo Payments customer_id
  billingSubscriptionId String?  // Dodo Payments subscription_id of the active plan
  createdAt        DateTime      @default(now())
  jobs             Job[]
  ledger           CreditEntry[]
  repoToken        RepoToken?
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SourceType {
  WEBSITE
  GITHUB
  UPLOAD // the customer's own video (reels)
}

model Job {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  status       JobStatus  @default(QUEUED)
  kind         String     @default("video") // video | reel (the customer's own video, captioned and edited)
  sourceType   SourceType
  sourceUrl    String     // the website or repo; for reels, the uploaded file's name
  title        String?    // the project's name, when the customer gave one (else it's named after its source)
  tone         String?
  format       String     @default("landscape")
  durationSec  Int        @default(20)
  notes        String?    // free-text direction from the customer
  parentJobId  String?    // set for revisions ("re-roll the outro")
  creditsCost  Int
  paidWith     String     @default("credits") // the balance that paid: credits | reels (a refund goes back there)
  watermark    Boolean    @default(false)
  privateRepo  Boolean    @default(false) // GitHub source fetched with the customer's saved token
  videoType    String     @default("launch") // launch | demo | feature
  music        String     @default("upbeat") // upbeat | composed | none
  brief        Json?      // optional guided brief: { launching, audience, highlights[], cta }
  quality      String     @default("standard") // standard | studio: the tier picks the engine (render/wrangler.jsonc)
  voice        String?    // voiceover voice id (packages/core/src/voices.ts); null means no voiceover
  captions     Boolean    @default(true) // with a voiceover: captions burned into the video
  template     String?    // the template the video started from (packages/core/src/templates.ts), if any
  reel         Json?      // reels: the options and the upload ({ style, emojis, zooms, sfx, hook, language, key, fileName, ... }; ReelJob in packages/core/src/reel.ts)

  videoUrl     String?
  posterUrl    String?
  captionsUrl  String?    // SRT captions, for videos with a voiceover and for reels
  shareCopy    String?
  plan         String?    // brag-plan.md, shown to the customer
  error        String?

  // --- unit economics, filled by the render Worker from the agent's result (summed across engine attempts) ---
  model            String?
  numTurns         Int?
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  llmCostUsd       Float?   // what the model provider charges us
  computeSeconds   Int?     // wall-clock of the worker, for compute COGS
  attempts         Int      @default(0)

  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  // --- the skills pipeline (docs/SKILLS_PIPELINE.md): which skill version made it, and whether it's an admin's test ---
  skillVersion String?    // SkillVersion.id; null for jobs made before the pipeline, on the image's baked-in skills
  test         Boolean    @default(false) // a hidden test job: never in a customer's projects or the funnel

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// The skills pipeline (docs/SKILLS_PIPELINE.md): the skills that make Hyped's videos, versioned, tested, scored and
// published from the admin side. A version's files live in R2 as one JSON pack (skills/<skill>/v<n>.json).

/** A skill the team keeps versions of: a scenario's (launch, update, ...) or a shared one (the core, the review). */
model Skill {
  id        String         @id // "launch", "update", ... or "core", "review" (SKILL_SLOTS in packages/core/src/skills.ts)
  name      String
  createdAt DateTime       @default(now())
  versions  SkillVersion[]
}

model SkillVersion {
  id         String    @id @default(cuid())
  skillId    String
  skill      Skill     @relation(fields: [skillId], references: [id])
  version    Int       // 1, 2, 3 ... per skill
  folder     String    // the folder it unpacks into in the workspace: "brag-slim", "hyped-launch", ...
  r2Key      String    // skills/<skill>/v<n>.json
  parentId   String?   // the version it was copied from
  authorId   String
  authorName String?
  note       String?
  status     String    @default("draft") // draft | tested | candidate | live | retired
  bytes      Int
  fileCount  Int
  lint       Json      // SkillLint: errors, warnings, sizes (lintSkill in packages/core/src/skills.ts)
  tools      String[]  // the runner tools it calls (.hyped/camera.js, ...)
  engines    String[]  // the engines it has passed on (step 3)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  runs       SkillRun[]

  @@unique([skillId, version])
}

/** One test video of a version (step 2–3): its product, engine and scores. */
model SkillRun {
  id          String       @id @default(cuid())
  versionId   String
  version     SkillVersion @relation(fields: [versionId], references: [id])
  jobId       String       @unique
  productUrl  String
  format      String
  engine      String
  score       Int?
  passed      Boolean?
  hardFails   String[]
  rounds      Int?
  humanRating Int?         // 1–5, from the admin who watched it
  createdAt   DateTime     @default(now())

  @@index([versionId])
}

/** The live pointer per skill (step 4): what real jobs run, and a candidate on a share of them. */
model SkillLive {
  skillId            String   @id
  liveVersionId      String
  candidateVersionId String?
  candidateShare     Int      @default(0) // percent of the skill's Standard jobs
  changedBy          String
  changedAt          DateTime @default(now())
  reason             String?
}

model CreditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int      // +grant / -spend / +refund
  reason    String   // "subscription:pro", "pack_1", "job:<id>", "refund:<id>"
  balance   String   @default("credits") // the balance it moved: credits | reels
  paymentRef String? @unique // idempotency key from the payment provider (payment, subscription period, refund, dispute)
  createdAt DateTime @default(now())
}

/// A customer's GitHub token for private repos. Encrypted in their browser to the render Worker's public key
/// (see packages/core/src/repo-token.ts); only the render Worker can decrypt it. This table never holds a
/// readable token.
model RepoToken {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sealed     String    // JSON envelope from sealToken(), bound to userId
  hint       String    // e.g. "github_pat…9f2c", so the customer can tell which token is saved
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
